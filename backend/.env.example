# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=5000

# Database Configuration
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:Iamafish123@@db.xxzrhnghbjnsbjyzvcem.supabase.co:5432/postgres
# Set DB_SSL=true when connecting to Supabase or any SSL-only Postgres database
DB_SSL=true

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# OTP Configuration
OTP_EXPIRY_MINUTES=10

# File Upload Configuration
MAX_FILE_SIZE_MB=10

# Email Service Configuration (Optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# AWS S3 Configuration (Optional)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=uirms-incidents
# AWS_REGION=ap-southeast-1

# Logging Configuration (Optional)
# LOG_LEVEL=info
# LOG_FILE=/var/log/uirms-api.log

# Redis Configuration (Optional - for caching)
# REDIS_URL=redis://localhost:6379

# Notes for production:
# - Change JWT_SECRET to a strong, random string
# - Enable SSL for database connection
# - Use environment variables or secrets manager instead of .env
# - Set NODE_ENV=production
# - Configure proper email service for notifications
# - Set up AWS S3 or similar for image storage
# - Enable Redis for caching and sessions
